// Window rules
window-rule {
    match app-id="^org\\.gnome\\."
    open-floating true
}

window-rule {
    match app-id="^imv$"
    open-floating true
}

window-rule {
    match app-id="^pavucontrol$"
    open-floating true
    default-column-width { fixed 600; }
    default-window-height { fixed 500; }
}

window-rule {
    match app-id="^blueman-manager$"
    open-floating true
    default-column-width { fixed 700; }
    default-window-height { fixed 550; }
}
