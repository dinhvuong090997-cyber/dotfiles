{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "cyan",
            "title": "blue"
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "os"
        },
        {
            "type": "kernel",
            "key": "kernel"
        },
        {
            "type": "uptime",
            "key": "uptime"
        },
        {
            "type": "packages",
            "key": "pkgs"
        },
        {
            "type": "wm",
            "key": "wm"
        },
        {
            "type": "shell",
            "key": "shell"
        },
        {
            "type": "terminal",
            "key": "term"
        },
        {
            "type": "cpu",
            "key": "cpu"
        },
        {
            "type": "gpu",
            "key": "gpu"
        },
        {
            "type": "memory",
            "key": "mem"
        },
        {
            "type": "disk",
            "key": "disk",
            "folders": "/"
        },
        "break",
        "colors"
    ]
}
